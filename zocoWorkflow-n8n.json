    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst resultados = [];\n\n// Iteramos sobre la longitud del arreglo de nombres\nfor (let i = 0; i < data.name.length; i++) {\n  resultados.push({\n    json: {\n      name: data.name[i],\n      location: data.location[i],\n      description: data.description[i]\n    }\n  });\n}\n\n// Retornamos un arreglo de items individuales para n8n\nreturn resultados;"
      },
